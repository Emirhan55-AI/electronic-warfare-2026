/* ==========================================================================
   TEKNOFEST 2026 ELEKTRONİK HARP OPERATÖR KONSOLU
   Modern, Low-Noise, Professional Dark Surface Design System
   ========================================================================== */

/* --------------------------------------------------------------------------
   Surface Hierarchy:
   - Application Background: #181818
   - Workspace / Center:     #1F1F1F
   - Raised Surface/Panels:  #1F1F1F
   - Hover / Selection:      #2B2B2B
   - Subtle Separators:      #3C3C3C
   - Primary Text:           #CCCCCC
   - Secondary Text:         #9D9D9D
   - Primary Accent:         #0078D4
   - Success / Confirm:      #2EA043
   - Warning / Alert:        #E2C08D
   - Danger / Error:         #F85149
   -------------------------------------------------------------------------- */

/* Global Window and Base Widget Styles */
QMainWindow, QDialog, QWidget#centralWidget {
    background-color: #181818;
    color: #CCCCCC;
    font-family: "Segoe UI", "SF Pro Text", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QWidget {
    color: #CCCCCC;
    selection-background-color: #2B2B2B;
    selection-color: #0078D4;
}

/* --------------------------------------------------------------------------
   Header Bar
   -------------------------------------------------------------------------- */
QFrame#header {
    background-color: #1F1F1F;
    border-bottom: 1px solid #3C3C3C;
    min-height: 48px;
    max-height: 52px;
}

QLabel#applicationTitle {
    font-size: 15px;
    font-weight: 700;
    color: #CCCCCC;
    letter-spacing: 0.5px;
}

QLabel#sourceValue {
    font-size: 13px;
    font-weight: 600;
    color: #0078D4;
    padding: 3px 8px;
    background-color: #1F1F1F;
    border-radius: 4px;
    border: 1px solid #3C3C3C;
}

QLabel#headerBadge {
    font-size: 11px;
    font-weight: 600;
    color: #9D9D9D;
    padding: 2px 6px;
    background-color: #1F1F1F;
    border-radius: 3px;
    border: 1px solid #3C3C3C;
}

/* --------------------------------------------------------------------------
   Left Navigation Sidebar
   -------------------------------------------------------------------------- */
QFrame#navSidebar {
    background-color: #1F1F1F;
    border-right: 1px solid #3C3C3C;
    min-width: 150px;
    max-width: 175px;
}

QPushButton.navButton {
    background-color: transparent;
    color: #9D9D9D;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    text-align: left;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.navButton:hover {
    background-color: #1F1F1F;
    color: #CCCCCC;
}

QPushButton.navButton[active="true"] {
    background-color: #1F1F1F;
    color: #0078D4;
    font-weight: 700;
    border-left: 3px solid #0078D4;
}

/* --------------------------------------------------------------------------
   Main Workspace and Containers
   -------------------------------------------------------------------------- */
QWidget#workspaceArea, QStackedWidget#workspaceStack {
    background-color: #181818;
}

QTabWidget::pane {
    border: none;
    background-color: #181818;
}

QTabBar::tab {
    background-color: #1F1F1F;
    color: #9D9D9D;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #CCCCCC;
    background-color: #1F1F1F;
}

QTabBar::tab:selected {
    color: #0078D4;
    background-color: #1F1F1F;
    border-bottom: 2px solid #0078D4;
}

/* --------------------------------------------------------------------------
   Selected Signal Inspector Panel (Right HUD)
   -------------------------------------------------------------------------- */
QFrame#selectedSignalCard {
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
}

QLabel#selectedSignalTitle {
    font-size: 13px;
    font-weight: 700;
    color: #9D9D9D;
    letter-spacing: 0.5px;
}

QLabel#selectedSignalFreq {
    font-size: 24px;
    font-weight: 700;
    color: #0078D4;
    letter-spacing: -0.5px;
}

QLabel#selectedSignalBadge {
    font-size: 12px;
    font-weight: 600;
    color: #2EA043;
    padding: 2px 8px;
    background-color: rgba(46, 160, 67, 0.12);
    border-radius: 4px;
    border: 1px solid rgba(46, 160, 67, 0.30);
}

QLabel#selectedSignalBadge[state="empty"] {
    color: #9D9D9D;
    background-color: transparent;
    border: none;
}

/* Two-column Key-Value Pair Layouts */
QLabel.propCaption {
    font-size: 12px;
    color: #9D9D9D;
}

QLabel.propValue {
    font-size: 12px;
    font-weight: 600;
    color: #CCCCCC;
}

QLabel.propValueAccent {
    font-size: 12px;
    font-weight: 700;
    color: #0078D4;
}

QFrame#subtleSeparator {
    background-color: #3C3C3C;
    max-height: 1px;
    min-height: 1px;
    margin: 4px 0px;
}

/* --------------------------------------------------------------------------
   Sleek Data Tables & Lists
   -------------------------------------------------------------------------- */
QTableWidget, QListWidget {
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    gridline-color: #2B2B2B;
    color: #CCCCCC;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #1F1F1F;
    color: #9D9D9D;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 8px;
    border: none;
    border-bottom: 1px solid #3C3C3C;
}

QTableWidget::item, QListWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #2B2B2B;
}

QTableWidget::item:selected, QListWidget::item:selected {
    background-color: #2B2B2B;
    color: #0078D4;
}

QTableWidget::item:hover, QListWidget::item:hover {
    background-color: #1F1F1F;
}

/* --------------------------------------------------------------------------
   Controls & Inputs
   -------------------------------------------------------------------------- */
QPushButton {
    background-color: #1F1F1F;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #2B2B2B;
    border-color: #0078D4;
    color: #CCCCCC;
}

QPushButton:pressed {
    background-color: #1F1F1F;
}

QPushButton:disabled {
    background-color: #1F1F1F;
    border-color: #3C3C3C;
    color: #6E7681;
}

QPushButton#primaryButton {
    background-color: #0078D4;
    color: #FFFFFF;
    border: 1px solid #3C3C3C;
    font-weight: 700;
}

QPushButton#primaryButton:hover {
    background-color: #026EC1;
    border-color: #6CADDF;
}

QPushButton#primaryButton:disabled {
    background-color: #1F1F1F;
    border-color: #3C3C3C;
    color: #6E7681;
}

QPushButton#dangerButton, QPushButton#etEmergencyStop {
    background-color: #F85149;
    color: #FFFFFF;
    border: 1px solid #F85149;
    font-weight: 700;
}

QPushButton#dangerButton:hover, QPushButton#etEmergencyStop:hover {
    background-color: #F85149;
}

QToolButton {
    background-color: transparent;
    color: #9D9D9D;
    border: none;
    font-size: 12px;
    padding: 3px 6px;
}

QToolButton:hover {
    color: #0078D4;
}

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: #313131;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    min-height: 22px;
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border-color: #0078D4;
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border-color: #0078D4;
    background-color: #1F1F1F;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    selection-background-color: #2B2B2B;
    selection-color: #0078D4;
    color: #CCCCCC;
}

QCheckBox {
    color: #CCCCCC;
    font-size: 12px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #0078D4;
    border-color: #3C3C3C;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #3C3C3C;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #0078D4;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
    background-color: #CCCCCC;
}

/* --------------------------------------------------------------------------
   Dock Widgets & Splitters
   -------------------------------------------------------------------------- */
QDockWidget {
    color: #CCCCCC;
    font-weight: 600;
    font-size: 12px;
    titlebar-close-icon: url();
    titlebar-normal-icon: url();
}

QDockWidget::title {
    background-color: #1F1F1F;
    border-bottom: 1px solid #3C3C3C;
    padding: 6px 10px;
    color: #9D9D9D;
    font-weight: 600;
}

QSplitter::handle {
    background-color: #181818;
}

QSplitter::handle:hover {
    background-color: #0078D4;
}

QScrollArea {
    border: none;
    background-color: #181818;
}

QScrollArea > QWidget > QWidget {
    background-color: #181818;
}

/* --------------------------------------------------------------------------
   Search / Sinyal Tespiti Control Groups
   -------------------------------------------------------------------------- */
QFrame#searchControlsContainer {
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    border-radius: 6px;
}

QFrame#controlGroup {
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
}

QLabel#controlGroupTitle {
    font-size: 10px;
    font-weight: 700;
    color: #6E7681;
    letter-spacing: 0.8px;
}

QListWidget#detectionList {
    background-color: #1F1F1F;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 2px;
}

QListWidget#detectionList::item {
    padding: 5px 8px;
    border-radius: 3px;
    margin-bottom: 2px;
}

QListWidget#detectionList::item:hover {
    background-color: #2B2B2B;
}

QListWidget#detectionList::item:selected {
    background-color: #202020;
    color: #0078D4;
}

/* --------------------------------------------------------------------------
   Menu Bar and Status Bar
   -------------------------------------------------------------------------- */
QMenuBar {
    background-color: #1F1F1F;
    color: #9D9D9D;
    border-bottom: 1px solid #3C3C3C;
    font-size: 12px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
}

QMenuBar::item:selected {
    background-color: #2B2B2B;
    color: #CCCCCC;
}

QMenu {
    background-color: #1F1F1F;
    color: #CCCCCC;
    border: 1px solid #3C3C3C;
    padding: 4px;
    font-size: 12px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #2B2B2B;
    color: #0078D4;
}

QMenu::separator {
    height: 1px;
    background-color: #3C3C3C;
    margin: 4px 6px;
}

QStatusBar {
    background-color: #1F1F1F;
    color: #9D9D9D;
    border-top: 1px solid #3C3C3C;
    font-size: 11px;
}

QStatusBar QLabel {
    color: #9D9D9D;
}

QLabel#statusTxLock {
    color: #E2C08D;
    font-weight: 700;
    padding: 0 10px;
}

/* Notifications */
QLabel#notification {
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#notification[kind="warning"] {
    background-color: rgba(226, 192, 141, 0.15);
    border: 1px solid #E2C08D;
    color: #E2C08D;
}

QLabel#notification[kind="error"] {
    background-color: rgba(248, 81, 73, 0.15);
    border: 1px solid #F85149;
    color: #CCCCCC;
}

/* --------------------------------------------------------------------------
   Scrollbars
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background-color: #1F1F1F;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #3C3C3C;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0078D4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1F1F1F;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #3C3C3C;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0078D4;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
