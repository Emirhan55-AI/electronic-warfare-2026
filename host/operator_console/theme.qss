QWidget {
    background: #0B0F14;
    color: #E8EEF5;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow, QSplitter::handle {
    background: #0B0F14;
}

QSplitter::handle:horizontal {
    width: 8px;
}

QSplitter::handle:vertical {
    height: 8px;
}

QFrame#header, QFrame#metadataPanel, QFrame#controls {
    background: #121922;
    border: 1px solid #27313D;
    border-radius: 4px;
}

QLabel#applicationTitle {
    color: #E8EEF5;
    font-size: 12pt;
    font-weight: 600;
}

QLabel#sectionTitle {
    color: #E8EEF5;
    font-size: 11pt;
    font-weight: 600;
}

QLabel#caption, QLabel#metadataCaption {
    color: #98A7B7;
}

QLabel#sourceValue, QLabel#metadataValue, QLabel#profileValue, QLabel#parameterValue {
    color: #E8EEF5;
    font-weight: 500;
}

QLabel#sourceValue {
    font-size: 9pt;
}

QLabel#calibrationNote {
    background: #0E151D;
    border: 1px solid #27313D;
    border-radius: 4px;
    color: #98A7B7;
    padding: 10px;
}

QLabel#profileValue, QLabel#detectionState, QLabel#detectionNote, QLabel#parameterState {
    color: #98A7B7;
}

QLabel#profileValue {
    background: #0E151D;
    border: 1px solid #27313D;
    border-radius: 4px;
    padding: 8px;
}

QListWidget#detectionList {
    background: #0E151D;
    border: 1px solid #27313D;
    border-radius: 4px;
    color: #E8EEF5;
    outline: 0;
    padding: 4px;
}

QListWidget#detectionList::item {
    border-bottom: 1px solid #202A35;
    padding: 6px 4px;
}

QListWidget#detectionList::item:selected {
    background: #1C2B38;
}

QLabel#stateValue {
    color: #98A7B7;
    padding-left: 8px;
}

QLabel#emptyPlotHint {
    color: #7F8D9C;
    background: transparent;
    padding: 12px;
}

QLabel#notification {
    background: #121922;
    border: 1px solid #27313D;
    border-radius: 4px;
    padding: 9px 12px;
}

QLabel#notification[kind="warning"] {
    border-color: #E6A23C;
    color: #F2C46D;
}

QLabel#notification[kind="error"] {
    border-color: #E05252;
    color: #F08A8A;
}

QPushButton, QComboBox, QSpinBox {
    min-height: 30px;
    background: #18212B;
    border: 1px solid #344252;
    border-radius: 4px;
    color: #E8EEF5;
    padding: 0 10px;
}

QPushButton:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #3A9DFF;
}

QPushButton:pressed {
    background: #1C2B38;
}

QPushButton:disabled, QComboBox:disabled, QSpinBox:disabled, QCheckBox:disabled {
    color: #617080;
    border-color: #27313D;
}

QPushButton#primaryButton {
    background: #196FB0;
    border-color: #3A9DFF;
    font-weight: 600;
}

QCheckBox {
    spacing: 7px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #526274;
    border-radius: 3px;
    background: #0B0F14;
}

QCheckBox::indicator:checked {
    background: #3A9DFF;
    border-color: #3A9DFF;
}

QToolTip {
    background: #18212B;
    border: 1px solid #344252;
    color: #E8EEF5;
    padding: 4px;
}
