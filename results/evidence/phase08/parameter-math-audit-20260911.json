    "obw99": "smooth four-frame mean excess with [0.25,0.5,0.25], subtract 2.5*n*sqrt(0.375/4), find 0.75%/99.25% cumulative edges, expand each edge 0.375 FFT bin; reject edge clipping or >7-bin leave-one-out instability",
    "emission_center": "first moment of positive smoothed excess-power weights, with temporal and broad-support gates",
    "snr_estimate": "W=max(4*sqrt(positive-excess spectral variance),1); 0.8*10*log10(T/(n*W))+1.6 dB; an in-band spectral estimate, not full-band time-domain input SNR",
    "dbm": "channel_power_dbfs + calibration_offset_db, only inside matching receiver context and validity bounds"
  },
