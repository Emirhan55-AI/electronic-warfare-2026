    bus_source: false
    bus_structure: null
    coordinate: [584, 156.0]
    rotation: 0
    state: enabled

connections:
- [analog_random_source_x_0, '0', digital_psk_mod_0, '0']
- [digital_psk_mod_0, '0', soapy_hackrf_sink_0, '0']

